Options -Indexes
AddDefaultCharset UTF-8

# Cada idioma declarado en el hreflang del <head> y en sitemap.xml (es/en/pt/
# it/fr/ja/ko/pl/bg/sr) usa la URL "/?lang=XX", pero hasta ahora esa URL
# devolvía siempre el mismo index.html en español: un rastreador que no
# ejecuta JS (la mayoría de los de IA) veía 10 URLs declaradas como
# alternativas de idioma con el mismo contenido crudo. _fuente/build.js ahora
# pre-renderiza un {lang}.html real por idioma (con dict.js/faq-dict.js, las
# mismas traducciones que ya usaba el sitio en cliente); esta regla sirve ese
# fichero SIN cambiar la URL visible, así que sitemap/hreflang siguen valiendo
# tal cual están.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{QUERY_STRING} (^|&)lang=(en|pt|it|fr|ja|ko|pl|bg|sr)(&|$)
    RewriteRule ^$ %2.html [L]
</IfModule>

# 404.html existía en el sitio pero nunca estaba enganchado como página de
# error real: una URL rota devolvía el 404 por defecto del servidor, no el
# diseño de la marca. La ruta es absoluta porque Apache sirve este mismo
# fichero para CUALQUIER URL inexistente, a cualquier profundidad.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com https://unpkg.com; img-src 'self' data: https://flagcdn.com https://images.weserv.nl https://i.imgur.com; connect-src 'self' https://translate.googleapis.com; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# Bloquea el acceso directo a JSON de datos internos que no deban servirse tal cual
<FilesMatch "\.(env|log)$">
    Require all denied
</FilesMatch>

# datos_oficiales.json cambia cada vez que se guarda desde el gestor: sin esta
# cabecera el navegador puede servir una copia cacheada sin comprobar primero
# si hay una versión nueva. "no-cache" (no "no-store") sigue dejando que el
# ETag/Last-Modified ya presentes ahorren la descarga completa cuando el
# archivo no ha cambiado — ver el fetch() de app.js, que pide lo mismo.
<IfModule mod_headers.c>
    <Files "datos_oficiales.json">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>

# _fuente/build.js funde CSS y JS DENTRO de cada .html (no hay app.js/styles.css
# sueltos que el navegador pueda versionar por nombre de archivo). Sin cabecera
# propia, index.html/en.html/etc. quedan a merced de la caché heurística del
# navegador (o de un proxy del operador móvil, que cachea agresivamente HTML
# sobre datos móviles) y un visitante puede quedarse viendo una versión vieja
# de la página — con su JS viejo incluido — después de cada despliegue, sin
# enterarse. Mismo criterio que datos_oficiales.json: revalidar siempre.
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
