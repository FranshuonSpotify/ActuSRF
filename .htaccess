Options -Indexes -MultiViews
AddDefaultCharset UTF-8

# Cada .html va con CSS+JS fundidos dentro (600KB+ por página, ver más abajo)
# y no había compresión de ningún tipo: cada visita bajaba ese peso entero
# sin comprimir. gzip/deflate de texto suele recortar HTML/CSS/JS un
# 70-80%, así que es la mejora de rendimiento con más impacto y menos
# riesgo posible aquí: no cambia ni una byte de lo que el navegador ve,
# solo cómo viaja por cable.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/ld+json application/xml
    AddOutputFilterByType DEFLATE application/rss+xml application/atom+xml
    AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

# Fuentes e iconos propios (assets/fonts, favicons) no cambian nunca de
# contenido bajo la misma URL: cuando hace falta invalidarlos ya se hace a
# mano con "?v=" en el nombre (ver head de shell.html), así que cachearlos
# un año entero es seguro. Las imágenes de assets/ (escudos, fotos de staff)
# sí pueden reemplazarse con el mismo nombre desde el disco, así que se
# cachean bastante menos para no dejar una imagen vieja pegada semanas.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/png "access plus 1 week"
    ExpiresByType image/jpeg "access plus 1 week"
    ExpiresByType image/webp "access plus 1 week"
</IfModule>

# Cada idioma declarado en el hreflang del <head> y en sitemap.xml (es/en/pt/
# it/fr/ja/ko/pl/bg/sr) usa la URL "/?lang=XX", pero hasta ahora esa URL
# devolvía siempre el mismo index.html en español: un rastreador que no
# ejecuta JS (la mayoría de los de IA) veía 10 URLs declaradas como
# alternativas de idioma con el mismo contenido crudo. _fuente/build.js ahora
# pre-renderiza un {lang}.html real por idioma (con dict.js/faq-dict.js, las
# mismas traducciones que ya usaba el sitio en cliente); esta regla sirve ese
# fichero SIN cambiar la URL visible, así que sitemap/hreflang siguen valiendo
# tal cual están.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Search Console marcaba http://superligafrontier.es/ como "página
    # alternativa con etiqueta canónica adecuada": Google llegaba a la URL
    # sin cifrar y solo el <link rel="canonical"> evitaba que se indexara
    # por duplicado. Con este 301 deja de rastrearla directamente.
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # URLs limpias: sin .html ni .php, y la portada siempre como "/".
    # Las redirecciones miran THE_REQUEST (la petición tal cual llegó del
    # navegador) y no la ruta ya reescrita: si no, la reescritura interna de
    # más abajo (/terminos -> terminos.html) volvería a disparar el 301 y
    # entraría en bucle. Solo GET: un 301 a un POST pierde el formulario, así
    # que los action="guardar.php" siguen funcionando tal cual.
    RewriteCond %{THE_REQUEST} ^GET\ /((?:[^?\ ]*/)?)index\.(?:html|php)[?\ ]
    RewriteRule ^ /%1 [R=301,L]

    # /fr.html y /fr son el mismo contenido que /?lang=fr, que es la URL que
    # declaran hreflang y sitemap.xml: se unifican en esa.
    RewriteCond %{THE_REQUEST} ^GET\ /(en|pt|it|fr|ja|ko|pl|bg|sr)(?:\.html)?[?\ ]
    RewriteRule ^ /?lang=%1 [R=301,L]

    # api/, cron/ y los endpoints sueltos (api_apuestas.php...) los llaman
    # programas —cron de IONOS, Discord, fetch()— que no tienen por qué
    # seguir una redirección; se quedan con su URL de siempre. El fichero de
    # verificación de Google tampoco se toca.
    RewriteCond %{REQUEST_URI} !^/(api|cron|config)/
    RewriteCond %{REQUEST_URI} !^/(api_|test_|google[0-9a-f]+\.html)
    RewriteCond %{THE_REQUEST} ^GET\ /([^?\ ]+)\.(?:html|php)[?\ ]
    RewriteRule ^ /%1 [R=301,L]

    RewriteCond %{QUERY_STRING} (^|&)lang=(en|pt|it|fr|ja|ko|pl|bg|sr)(&|$)
    RewriteRule ^$ %2.html [L]

    # Y al revés: /terminos sirve terminos.html, /dashboard/plantilla sirve
    # plantilla.php. Una carpeta real (/gestor/) sigue yendo a su index.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+)$ $1.html [L]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+)$ $1.php [L]
</IfModule>

# 404.html existía en el sitio pero nunca estaba enganchado como página de
# error real: una URL rota devolvía el 404 por defecto del servidor, no el
# diseño de la marca. La ruta es absoluta porque Apache sirve este mismo
# fichero para CUALQUIER URL inexistente, a cualquier profundidad.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com https://unpkg.com; img-src 'self' data: https://flagcdn.com https://images.weserv.nl https://i.imgur.com https://static.wikia.nocookie.net; connect-src 'self' https://translate.googleapis.com; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# Bloquea el acceso directo a JSON de datos internos que no deban servirse tal cual
<FilesMatch "\.(env|log)$">
    Require all denied
</FilesMatch>

# datos_oficiales.json cambia cada vez que se guarda desde el gestor: sin esta
# cabecera el navegador puede servir una copia cacheada sin comprobar primero
# si hay una versión nueva. "no-cache" (no "no-store") sigue dejando que el
# ETag/Last-Modified ya presentes ahorren la descarga completa cuando el
# archivo no ha cambiado — ver el fetch() de app.js, que pide lo mismo.
<IfModule mod_headers.c>
    <Files "datos_oficiales.json">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>

# _fuente/build.js funde CSS y JS DENTRO de cada .html (no hay app.js/styles.css
# sueltos que el navegador pueda versionar por nombre de archivo). Sin cabecera
# propia, index.html/en.html/etc. quedan a merced de la caché heurística del
# navegador (o de un proxy del operador móvil, que cachea agresivamente HTML
# sobre datos móviles) y un visitante puede quedarse viendo una versión vieja
# de la página, con su JS viejo incluido, después de cada despliegue, sin
# enterarse. Mismo criterio que datos_oficiales.json: revalidar siempre.
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
